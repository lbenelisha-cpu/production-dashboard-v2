+// Parses in a Web Worker so the ~1.1GB cost of a large SAP export lands in the
+// worker's heap and the UI stays responsive. Falls back to the main thread when
+// workers are unavailable (older browsers, some embedded webviews) or when the
+// worker itself fails to start.
+// Turns a parse failure into something a plant engineer can act on. The old code
+// funnelled every one of these into "סוג הקובץ לא זוהה".
+function describeParseFailure(file, sizeMB, error) {
+  const code = error?.code || ''
+  if (code === 'MISSING_COLUMNS') return `${file.name}: חסרות עמודות חובה — ${(error.missing || []).join(', ')}`
+  if (code === 'EMPTY_WORKBOOK') return `${file.name}: הקובץ נקרא אך לא נמצאו בו שורות נתונים. ודא ששורת הכותרות היא הראשונה בגיליון.`
+  if (code === 'UNKNOWN_KIND') return `${file.name}: סוג הקובץ לא זוהה לפי הכותרות שנמצאו (${(error.headers || []).join(', ')}...). טען אותו מאזור הטעינה הייעודי במרכז הנתונים.`
+  if (code === 'WORKER_CRASHED' || sizeMB >= 15) {
+    return `${file.name}: הקובץ (${sizeMB.toFixed(0)}MB) גדול מכדי להיקרא בדפדפן — תהליך הקריאה קרס מחוסר זיכרון. פצל את הייצוא מ-SAP (לפי חודש או מתקן) וטען את החלקים בזה אחר זה.`
+  }
+  return `${file.name}: קריאת הקובץ נכשלה — ${error?.message || 'שגיאה לא ידועה'}`
+}
+
+function parseWorkbookOffThread(file, forcedKind, onProgress) {
+  if (typeof Worker === 'undefined') return parseWorkbookFile(file, forcedKind)
+  let worker
+  try {
+    worker = new Worker(new URL('./workbookWorker.js', import.meta.url), { type: 'module' })
+  } catch {
+    return parseWorkbookFile(file, forcedKind)
+  }
+  return new Promise((resolve, reject) => {
+    const finish = (fn, payload) => { worker.terminate(); fn(payload) }
+    worker.onmessage = (event) => {
+      const data = event.data || {}
+      if (data.type === 'progress') { onProgress?.(data); return }
+      if (data.type === 'done') return finish(resolve, data)
+      if (data.type === 'error') {
+        const error = new Error(data.message)
+        error.code = data.code; error.missing = data.missing; error.headers = data.headers
+        return finish(reject, error)
+      }
+    }
+    // Fires when the worker is killed — most often an out-of-memory abort on a
+    // very large file. The tab survives, so we can report it properly.
+    worker.onerror = (event) => {
+      const error = new Error(event?.message || 'WORKER_CRASHED')
+      error.code = 'WORKER_CRASHED'
+      finish(reject, error)
+    }
+    worker.postMessage({ file, forcedKind, requestId: 1 })
+  })
+}
